{
  "id": "lesson-01",
  "number": 1,
  "title": "中輩子音入門＋四個基本母音",
  "summary": "認識 8 個子音（6 個中輩＋น ม 兩個鼻音）與 า ิ ี ู 四個母音，用 16 個單字拼出第一批簡單句。",
  "status": "draft",
  "rules": [
    {
      "id": "r1",
      "title": "泰文字母有「頭」",
      "body": "多數泰文字母從「頭」（圓圈或彎鉤）開始書寫，認字時先找頭，再看身體往哪個方向延伸。",
      "strokes": null
    },
    {
      "id": "r2",
      "title": "母音有固定位置",
      "body": "母音依附在子音旁：า 寫在子音右邊；ิ ี 寫在子音上方；ู 寫在子音下方。本課母音都以 อ 當示範子音（อา อิ อี อู）。",
      "strokes": null
    },
    {
      "id": "r3",
      "title": "長短母音",
      "body": "า ี ู 是長音（拖長一點），ิ 是短音（短促）。長短不同，單字就不同。",
      "strokes": null
    },
    {
      "id": "r4",
      "title": "尾音的收法",
      "body": "ก 結尾收 k；ด 結尾收 t；บ ป 結尾收 p；น ม 結尾收 n / m。尾音收 k t p 的短促音節，聲調會變低（例：ปิด bpìt、กบ gòp）。",
      "strokes": null
    }
  ],
