{
  "status": "draft",
  "rules": [
    {
      "id": "r1",
      "title": "以第一個字母 ก 為例：為什麼子音要搭配母音才能念？",
      "body": "ก 這個字母只代表 g 這個聲母，單獨一個 g 沒辦法唸成完整的音節（就像英文字母 g 單獨一個也唸不出來，要加上母音才行）。所以學子音時，習慣替每個子音都加上同一個母音 อ（長母音，念「喔」，拼音 or）：ก ＋ อ ＝ กอ（gor）。",
      "demo": [
        {
          "th": "ก",
          "sub": "子音　g"
        },
        {
          "op": "＋",
          "th": "อ",
          "sub": "長母音 or"
        },
        {
          "op": "＝",
          "th": "กอ",
          "sub": "gor",
          "speak": "กอ"
        }
      ]
    },
    {
      "id": "r2",
      "title": "為什麼每個字母還要配一個例字？",
      "body": "因為泰文有不少字母發音相同。以這一課為例：ต 和 ฏ 都唸 dt，ด 和 ฎ 都唸 d；只唸「dt-or」分不出是哪一個字母。所以每個字母綁定一個固定的例字，唸名字時連例字一起唸：กอ ไก่ ＝「ก，就是 ไก่（雞）的那個 ก」。就像英文字母表的「A is for Apple」。",
      "demo": [
        {
          "th": "กอ",
          "sub": "名字　gor",
          "speak": "กอ"
        },
        {
          "op": "＋",
          "th": "ไก่",
          "sub": "例字　gài・雞",
          "speak": "ไก่"
        },
        {
          "op": "＝",
          "th": "กอ ไก่",
          "sub": "ก，就是「雞」的那個 ก",
          "speak": "กอไก่"
        }
      ]
    }
  ],
