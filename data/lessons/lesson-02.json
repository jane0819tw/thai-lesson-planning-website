  "status": "draft",
  "rules": [
    {
      "id": "r1",
      "title": "母音種類",
      "body": "單母音 9 組 18 個；複合母音 3 組 6 個；特殊母音 4 個（只有短音）；來自梵文的母音 2 組 4 個。"
    },
    {
      "id": "r2",
      "title": "長短音與位置",
      "body": "母音一組有長短音之分，長音的長度約是短音的兩倍。母音的位置可以在子音的上、下、左、右。"
    },
    {
      "id": "r3",
      "title": "拼讀範例",
      "body": "ก + ะ = กะ（/g/ /a/ → /gaˋ/）；ก + า = กา（/g/ /aa/ → /gaa/）。"
    }
  ],
