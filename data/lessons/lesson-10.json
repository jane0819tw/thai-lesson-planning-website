{
  "status": "draft",
  "rules": [
    {
      "id": "r1",
      "title": "5 音 10 字",
      "body": "m：ม；n：น（ณ ล ฬ ร ญ）；y：ย；w：ว；ng：ง。"
    },
    {
      "id": "r2",
      "title": "聲調規則",
      "body": "有清尾音，不論長短音，follow 長音的規則。"
    },
    {
      "id": "r3",
      "title": "發音口型",
      "body": "ม /m/：嘴巴閉起。ย /y/：嘴形往旁邊拉，發「一」。ว /w/：發「ㄨ」的嘴形。ง /ng/：發「ㄋㄡㄥ」，注意嘴形不會往旁邊拉。น（ล ร ณ ญ ฬ）/n/：音近「ㄣ」，嘴形要往旁邊成「一」狀。"
    }
  ],
