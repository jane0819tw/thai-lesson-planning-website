  "recap": [
    {
      "point": "學複合母音 /ia/ /eua/ /ua/",
      "items": [
        "每組都有**短音**和**長音**：เอียะ／เอีย、เอือะ／เอือ、อัวะ／อัว",
        "聲調規則和單母音**相同**"
      ],
      "toneTable": {
        "title": "",
        "rows": [
          {
            "label": "＋短母音",
            "cells": [
              "x",
              "เกียะ",
              "เกี้ยะ",
              "เกี๊ยะ",
              "(x)"
            ]
          },
          {
            "label": "＋長母音",
            "cells": [
              "เกีย",
              "เกี่ย",
              "เกี้ย",
              "เกี๊ย",
              "เกี๋ย"
            ]
          }
        ]
      }
    },
    {
      "point": "學只有短音的特殊母音 -ำ ไ- ใ- เ-า",
      "items": [
        "特殊母音**發短音**，聲調規則卻和**長母音**一樣",
        "ไ- 和 ใ- 念法相同，都是 /ai/"
      ]
    }
  ],
