 "patterns": [
  {
   "id": "p7",
   "th": "感受／態度 + กับ + 對象",
   "zh": "對於…；對…",
   "cmp": "กับ 平常是「和、跟」，接在 เบื่อ（厭煩）、ชิน（習慣）、ใจดี（好心）這類表示感受、態度的詞後面時，意思是「對於…」。後面接動作時先加 การ 變成名詞，像這句 เบื่อกับการรอ…（對等待感到厭煩）。",
   "examples": [
    {
     "th": "ฉันเบื่อกับรถติดทุกวัน",
     "rom": "chăn bèua gàp rót dtìt túk wan",
     "zh": "我對每天塞車感到厭煩。"
    },
    {
     "th": "ผมยังไม่ชินกับอากาศร้อน",
     "rom": "pŏm yang mâi chin gàp aa-gàat rórn",
     "zh": "我對炎熱的天氣還不習慣。"
    },
    {
     "th": "เขาใจดีกับทุกคน",
     "rom": "kăo jai dee gàp túk kon",
     "zh": "他對每個人都很好。"
    }
   ]
  },
  {
   "id": "p5",
   "th": "量詞／名詞 + เดียว",
   "zh": "只要一…；單單一…",
   "cmp": "เดียว 放在量詞或名詞後面，表示「只有一個」。คลิกเดียว＝點一下就好，強調動作少、很簡單。",
   "examples": [
    {
     "th": "ฉันไปคนเดียว",
     "rom": "chăn bpai kon dieow",
     "zh": "我一個人去。"
    },
    {
     "th": "รอแป๊บเดียวนะ",
     "rom": "ror bpáep dieow ná",
     "zh": "等一下下就好喔。"
    }
   ]
  },
  {
   "id": "p6",
   "th": "เพียง + 動詞… ก็…",
   "zh": "只要…就…",
   "cmp": "เพียง＝只、僅僅，比口語的 แค่ 正式，廣告、文章常見。後面常接 ก็（就）帶出結果；口語說 แค่…ก็…。",
   "examples": [
    {
     "th": "เพียงสแกน QR ก็จ่ายเงินได้",
     "rom": "piang sà-gaen QR gôr jàai ngern dâai",
     "zh": "只要掃 QR 就能付款。"
    },
    {
     "th": "เพียงสมัครสมาชิกก็ได้ส่วนลด",
     "rom": "piang sà-màk sà-maa-chík gôr dâai sùan lót",
     "zh": "只要加入會員就有折扣。"
    }
   ]
  },
  {
   "id": "p3",
   "th": "สามารถ + 動詞 + ได้",
   "zh": "能夠…；可以…",
   "cmp": "สามารถ 在動詞前、ได้ 在句尾，兩個一起包住動詞，比只用 ได้ 正式。口語常省略 สามารถ。",
   "examples": [
    {
     "th": "คุณสามารถจองตั๋วล่วงหน้าได้",
     "rom": "kun săa-mâat jong dtŭa lûang nâa dâai",
