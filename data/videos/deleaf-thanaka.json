 "patterns": [
  {
   "id": "p1",
   "th": "ทำให้ + 受詞 + 狀態",
   "zh": "使…變成…／讓…",
   "cmp": "中文「讓皮膚暗沉受損」和泰文詞序幾乎一樣：致使動詞 + 受詞 + 結果。這是華人最容易上手的句型。",
   "examples": [
    {
     "th": "แดดจัดทำให้ผิวไหม้",
     "rom": "dàet jàt tam hâi pĭw mâi",
     "zh": "大太陽讓皮膚曬傷。"
    },
    {
     "th": "ความเครียดทำให้นอนไม่หลับ",
     "rom": "kwaam krîiat tam hâi non mâi làp",
     "zh": "壓力讓人睡不著。"
    }
   ]
  },
  {
   "id": "p2",
   "th": "เติมความ + 形容詞",
   "zh": "補充…感／增添…度",
   "cmp": "ความ + 形容詞 = 名詞，相當於中文的「…感」「…度」。ความ 是泰語很重要的名詞化工具，中文沒有對應的詞。",
   "examples": [
    {
     "th": "เติมความฉ่ำไบร์ท",
     "rom": "dterm kwaam chàm brai",
     "zh": "補充水潤明亮感（兩個形容詞可以連著用）。"
    },
    {
     "th": "เติมความสดชื่น",
     "rom": "dterm kwaam sòt chêun",
     "zh": "增添清爽感。"
    },
    {
     "th": "เติมความชุ่มชื้น",
     "rom": "dterm kwaam chûm chéun",
     "zh": "補充水潤度。"
    }
   ]
  },
  {
   "id": "p3",
   "th": "ให้ + 受詞 + มี + 名詞",
   "zh": "讓…擁有…",
   "cmp": "ให้ 在這裡是「使、讓」，後面接受詞，再用 มี 說明受詞得到什麼。",
   "examples": [
    {
     "th": "ให้เด็กมีความสุข",
     "rom": "hâi dèk mee kwaam sùk",
     "zh": "讓孩子快樂（擁有幸福）。"
    },
    {
     "th": "ให้ผิวมีออร่า",
