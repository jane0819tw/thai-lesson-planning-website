node_modules
dist
.DS_Store
*.local
*.timestamp-*.mjs

# 含學生姓名與 Email 的信件樣本，不進版本控制
data/gmail/

# 聽寫用的 YouTube 字幕快取（影片的著作物，可由 scripts/dictation-build.py 重新抓取）
data/dictation/subtitles/

# 認字講義 PDF（老師的原始教材，檔案大，不進版本控制）
data/handouts/

# TypeScript 增量編譯快取
*.tsbuildinfo

# 影視片段的原始剪輯素材（老師給的 clip1.mp4、clip2.MOV…，只用來產生字幕影片）
data/videos/*/

# 加字幕前的合併影片（網站只用 video_th_sub.mp4）
public/extras/videos/*/video.mp4

# Azure 音檔試聽候選（scripts/gen-audio-azure.py 產生，選定後才蓋到 public/audio/）
public/audio/azure-preview/
